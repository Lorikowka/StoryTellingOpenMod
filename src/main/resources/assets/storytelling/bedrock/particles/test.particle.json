{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "iskra:test",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "storytelling:textures/test"
			}
		},
		"curves": {
			"variable.test": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 0.21, 1]
			}
		},
		"components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 5
      },
      "minecraft:emitter_shape_disc": {
        "radius": 1,
        "surface_only": false
      },
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 3.8
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180,180)",
				"rotation_rate": "math.random(-20,20)"
			},
			"minecraft:particle_initial_speed": 5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.sin(v.particle_age * 90)/2", -3, "math.cos(v.particle_age * 40)/2"],
				"linear_drag_coefficient": 5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(v.particle_random_1/8)+0.125", "(v.particle_random_1/8)+0.125"],
				"facing_camera_mode": "direction_y",
				"direction": {
					"mode": "custom",
					"custom_direction": [1, "math.cos(v.particle_age*v.particle_random_2*90)*0.5", "math.sin(v.particle_age*v.particle_random_2*90)*0.5"]
				},
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": ["v.particle_random_1>0.5?0:8", "v.particle_random_2>0.5?0:8"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color = (v.particle_random_1/2)+0.5;1-v.color;", "v.color", 0.25, "1 - (v.particle_age / v.particle_lifetime)"]
			}
		}
	}
}