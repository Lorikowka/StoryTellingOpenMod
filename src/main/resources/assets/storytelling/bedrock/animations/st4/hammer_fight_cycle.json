				},
				"RightArm": {
					"rotation": [0, 0, 0]
				},
				"RightHand": {
					"rotation": ["math.cos(query.anim_time*360/2)", "math.cos(query.anim_time*360/2)*4", 0]
				},
				"LeftArm": {
					"rotation": [0, 0, 0]
				},
				"LeftHand": {
					"rotation": ["math.cos(query.anim_time*360/2)", "math.cos(query.anim_time*360/2)*4", 0]
				}
			}
		}
	}
