				},
				"Head": {
					"rotation": ["math.cos(query.anim_time*360)/2", 0, 0]
				},
				"LeftArm": {
					"rotation": ["math.sin(query.anim_time*360)", 0, "-math.cos(query.anim_time*360)"]
				},
				"LeftHand": {
					"rotation": ["math.cos(query.anim_time*360)", 0, 0]
				},
				"RightArm": {
					"rotation": ["-math.sin(query.anim_time*360)", 0, " math.cos(query.anim_time*360)"]
				},
				"RightHand": {
					"rotation": ["-math.sin(query.anim_time*360)", 0, 0]
				},
				"LeftLeg": {
					"rotation": ["-math.sin(query.anim_time*360)", 0, "-math.cos(query.anim_time*360) "]
				},
				"RightLeg": {
					"rotation": ["math.sin(query.anim_time*360)", 0, "math.cos(query.anim_time*360) "]
				}
			}
		}
	}
}