{
	"format_version": "1.8.0",
	"animations": {
		"wiggle_hand_right": {
			"loop": true,
			"animation_length": 0.5,
			"bones": {
				"RightArm": {
					"rotation": [0, "math.cos(query.anim_time*360*2)*2", "math.sin(query.anim_time*360*2)"]
				},
				"RightHand": {
					"rotation": [0, 0, "math.sin(query.anim_time*360*2-45)*2"]
				}
			}
		},
		"wiggle_hand_left": {
			"loop": true,
			"animation_length": 0.5,
			"bones": {
				"LeftArm": {
					"rotation": [0, "-(math.cos(query.anim_time*360*2)*2)", "-(math.sin(query.anim_time*360*2))"]
				},
				"LeftHand": {
					"rotation": [0, 0, "-(math.sin(query.anim_time*360*2-45)*2)"]
				}
			}
		}
	}
}